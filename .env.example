DEBUG=True
SECRET_KEY=replace-this-with-a-long-random-string-for-production
ALLOWED_HOSTS=localhost,127.0.0.1,improv.pl,www.improv.pl

# SQLite for local dev (default). For production use Postgres:
DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgres://improvuser:yourstrongpass@localhost:5432/improvpl

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# For real emails (recommended free tier):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.brevo.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-brevo-or-mailtrap-login
# EMAIL_HOST_PASSWORD=your-smtp-password-or-api-key
DEFAULT_FROM_EMAIL=hello@improv.pl

